      "sha256": "e50584ee0eb39df11068a726418117958a0b2f3e5cd82ba76fe20ca63814d1d3"
    },
    "route_manifest": {
      "path": "configs/spatial_uq_route_manifests/b2d_expansion100_seed20260827.json",
